{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pajarori/farai-data/blob/main/schema/manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "generatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "contentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "minFaraiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "releaseNotes": { "type": "string", "maxLength": 4096 },
    "knowledge": { "$ref": "#/$defs/artifact" },
    "skills": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "schemaVersion": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
